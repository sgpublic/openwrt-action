#              x86_64              #
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

#               基础               #
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_default-settings=y
# IP 设置
CONFIG_IMAGEOPT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_IP="192.168.6.1"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.6.255"
# 使用域名访问
CONFIG_DEFAULT_SETTINGS_USE_IP=y
CONFIG_DEFAULT_SETTINGS_USE_DOMAIN=n
# 打包 VMware 镜像
CONFIG_VMDK_IMAGES=y
# CONFIG_GRUB_IMAGES is not set
# 修改分区大小
CONFIG_TARGET_KERNEL_PARTSIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=512
# 添加 SFTP 支持
CONFIG_PACKAGE_openssh-sftp-server=y
# 添加 ethtool
CONFIG_PACKAGE_ethtool-full=y
## 添加 frpc
CONFIG_PACKAGE_frp-client=y
## 添加 ohttps-webhook
#CONFIG_PACKAGE_ohttps-webhook=y
# 添加 nano
CONFIG_PACKAGE_nano-full=y
# 添加 git
CONFIG_PACKAGE_git-http=y
# 开机等待
CONFIG_GRUB_TIMEOUT="0"
# i225-v 驱动
CONFIG_PACKAGE_kmod-igc=y
# nginx 添加 stream 支持
CONFIG_PACKAGE_nginx-mod-stream=y
# 恢复备份
CONFIG_DEFAULT_SETTINGS_USE_BACKUP=y
CONFIG_DEFAULT_SETTINGS_USE_BACKUP_REPO_URL="https://$GITEE_USER:$GITEE_TOKEN@gitee.com/sgpublic/nas-config"
CONFIG_DEFAULT_SETTINGS_USE_BACKUP_REPO_BRANCH="openwrt"

#               主题               #
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

#               插件               #
CONFIG_PACKAGE_luci-app-wolplus=y
#CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-openclash=y

#               其他               #
# 解决 luci-app-argon-config 依赖缺失
CONFIG_PACKAGE_luci-lib-ipkg=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# 启用 CCACHE
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_BINARY_FOLDER="/tmp/openwrt/binary"
CONFIG_DOWNLOAD_FOLDER="/tmp/openwrt/download"
CONFIG_LOCALMIRROR="/tmp/openwrt/mirror"
CONFIG_CCACHE_DIR="/tmp/openwrt/ccache"
CONFIG_BUILD_LOG_DIR="/tmp/openwrt/log"
